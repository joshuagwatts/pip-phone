<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Phone Pip talks to desktop over cleartext LAN http://192.168.x.x:7420 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
