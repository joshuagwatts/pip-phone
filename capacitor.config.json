{
  "appId": "com.pip.phone",
  "appName": "Pip",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "disable",
    "backgroundColor": "#0a0f0a"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0a0f0a",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
